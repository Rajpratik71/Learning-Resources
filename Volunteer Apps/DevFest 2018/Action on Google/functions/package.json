    "firebase-functions": "^4.0.1",
    "googleapis": "^124.0.0",
    "request": "^2.88.0",
    "@snyk/protect": "latest"
  },
  "devDependencies": {
    "eslint": "^4.12.0",
    "eslint-plugin-promise": "^3.6.0"
  },
  "private": true,
  "snyk": true
}
